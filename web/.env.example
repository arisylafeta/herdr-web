# Leave unset when this PWA is served by its bridge (the default combined deployment).
# Set it when web/dist is hosted independently so the built-in receiver targets the bridge rather
# than the static host. The bridge must allow the PWA's exact HTTPS origin with
# COLLIE_ALLOWED_ORIGINS.
VITE_HERDR_BRIDGE_URL=https://machine.your-tailnet.ts.net:8787
VITE_HERDR_BRIDGE_LABEL=Primary machine
